<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<title>簡易家計簿</title>

<style>
body{
  font-family:sans-serif;
  width:700px;
  margin:auto;
}

table{
  width:100%;
  border-collapse:collapse;
}

td,th{
  border:1px solid black;
  padding:5px;
}

.summary{
  margin:20px 0;
}
</style>

</head>
<body>

<h1>簡易家計簿アプリ</h1>

<form action="/add" method="post">

<select name="type">
  <option value="income">収入</option>
  <option value="expense">支出</option>
</select>

<input
type="number"
name="amount"
placeholder="金額"
required>

<input
type="text"
name="memo"
placeholder="内容"
required>

<button type="submit">
登録
</button>

</form>

<div class="summary">
<h3>総収入: <%= income %> 円</h3>
<h3>総支出: <%= expense %> 円</h3>
<h2>残高: <%= balance %> 円</h2>
</div>

<table>

<tr>
<th>種類</th>
<th>金額</th>
<th>内容</th>
</tr>

<% records.forEach(record => { %>

<tr>
<td>
<%= record.type === "income" ? "収入" : "支出" %>
</td>

<td>
<%= record.amount %>
</td>

<td>
<%= record.memo %>
</td>

</tr>

<% }) %>

</table>

</body>
</html>
